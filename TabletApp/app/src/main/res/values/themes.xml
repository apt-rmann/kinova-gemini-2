<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RobotCaregiver" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
         <item name="colorPrimary">@color/mh_1</item>
        <item name="colorSecondary">@color/mh_2</item>
    </style>

    <style name="Theme.RobotCaregiver" parent="Base.Theme.RobotCaregiver" />

    <!-- Config editor screen (RobotActivity). Its Material text fields and dropdown need a
         MaterialComponents theme; the rest of the app stays on Theme.AppCompat. -->
    <style name="Theme.RobotCaregiver.Config" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/mh_1</item>
        <item name="colorPrimaryVariant">@color/mh_1</item>
        <item name="android:statusBarColor">@color/mh_1</item>
        <item name="colorSecondary">@color/mh_2</item>
    </style>
</resources>