# Goal - drive the TCP to a target with Twist (velocity) commands, translation only

# the target is not sent in the goal: the caller streams the vector from the TCP to the target on
# /servo_vector (geometry_msgs/Vector3Stamped, base_link components) for as long as the goal runs

float32 stop_distance   # meters; succeed once the vector is shorter than this
---
# Result
bool success
string message
---
# Feedback
float32 distance_to_go
