<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_interfaces</name>
  <version>0.0.0</version>
  <description>Custom ROS2 interfaces for commanding robot</description>
  <maintainer email="jxm1536@case.edu">mcrr-lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend> 

  <!-- runs at build to generate Python code from custom interfaces -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend> 

  <!-- needed so other packages can use generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- registers interface package so other packages can find it -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
